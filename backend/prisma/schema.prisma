datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String          @id @default(uuid())
  name       String
  email      String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  embeddings FaceEmbedding[]
}

model FaceEmbedding {
  id        String   @id @default(uuid())
  userId    String
  embedding String   // Serialized JSON string of the 512-dim float array (SQLite handles strings as text automatically)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
